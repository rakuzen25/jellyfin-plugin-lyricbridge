<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Infrastructure/LyricBridge.Infrastructure.csproj" />
    <Compile Include="../Support/*.cs" Link="Support/%(Filename)%(Extension)" />
    <Reference Include="$(JellyfinReferenceDir)/Microsoft.Data.Sqlite.dll" />
    <Reference Include="$(JellyfinReferenceDir)/SQLitePCLRaw.*.dll" />
    <None Include="$(JellyfinReferenceDir)/libe_sqlite3.so" CopyToOutputDirectory="PreserveNewest" Link="libe_sqlite3.so" />
    <PackageReference Include="xunit.v3" Version="4.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
