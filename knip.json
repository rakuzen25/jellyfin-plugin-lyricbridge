{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": ["tests/tooling/**/*.test.mjs"],
            "project": ["*.mjs", "tests/tooling/**/*.mjs"],
            "ignoreDependencies": ["@taplo/cli"]
        },
        "frontend": {
            "entry": ["bridge.ts", "renderer.ts", "admin/config.ts", "**/*.test.ts", "build.mjs", "check-boundaries.mjs"],
            "project": ["**/*.{ts,mjs}"],
            "ignoreDependencies": ["@typescript/native"]
        },
        "tests/browser": {
            "entry": ["playwright.config.cjs", "**/*.spec.cjs", "compare-playback-performance.cjs", "check-image.mjs"],
            "project": ["**/*.cjs", "**/*.mjs"]
        }
    }
}
