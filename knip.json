{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": ["tests/tooling/**/*.test.mjs", "tests/tooling/renovate-policy.mjs"],
            "project": ["*.mjs", "tests/tooling/**/*.mjs"],
            "ignoreDependencies": [
                "@taplo/cli",
                "chokidar",
                "http-proxy-middleware",
                "remark-cli",
                "remark-gfm",
                "remark-lint",
                "remark-lint-no-undefined-references",
                "remark-validate-links",
                "unist-util-visit",
                "hast-util-from-html"
            ]
        },
        "frontend": {
            "entry": ["bridge.ts", "renderer.ts", "admin/config.ts", "**/*.test.ts", "check-boundaries.mjs"],
            "project": ["**/*.{ts,mjs}"],
            "ignoreDependencies": ["@typescript/native"]
        },
        "tests/browser": {
            "entry": ["playwright.config.cjs", "**/*.spec.cjs", "compare-playback-performance.cjs"],
            "project": ["**/*.cjs"]
        }
    },
    "ignoreBinaries": ["uv"]
}
