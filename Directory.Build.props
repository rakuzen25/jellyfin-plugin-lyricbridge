<Project>
  <PropertyGroup><PluginRepositoryRoot>$(MSBuildThisFileDirectory)</PluginRepositoryRoot></PropertyGroup>
  <Import Project=".build/jpt/msbuild/Plugin.props" />
  <PropertyGroup><LyricBridgeVersion>$(PluginVersion)</LyricBridgeVersion></PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LyricBridgeGuid" Value="$(PluginGuid)" />
    <AssemblyMetadata Include="LyricBridgeName" Value="$(PluginName)" />
  </ItemGroup>
</Project>
