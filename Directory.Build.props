<Project>
  <PropertyGroup>
    <LyricBridgeVersion>0.1.4</LyricBridgeVersion> <!-- x-release-please-version -->
    <LyricBridgeGuid>70a9d327-7e98-4201-88a5-724d39366c40</LyricBridgeGuid>
    <LyricBridgeName>LyricBridge</LyricBridgeName>
    <LyricBridgeOwner>LyricBridge contributors</LyricBridgeOwner>
    <LyricBridgeOverview>Multilingual karaoke lyrics</LyricBridgeOverview>
    <LyricBridgeDescription>Multilingual karaoke lyrics with an automatically injected web renderer and
      writable plugin storage</LyricBridgeDescription>
    <LyricBridgeCategory>General</LyricBridgeCategory>
    <JellyfinTargetAbi>12.2.0.0</JellyfinTargetAbi>
    <JellyfinReferenceDir Condition="'$(JellyfinReferenceDir)' == ''">
      $(MSBuildThisFileDirectory).build/jellyfin</JellyfinReferenceDir>
    <Deterministic>true</Deterministic>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
  <!-- Shared maintained-project policy; the upstream helper owns its own target/version. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Lyricify.Lyrics.Helper'">
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(LyricBridgeVersion)</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Lyricify.Lyrics.Helper' and '$(MSBuildProjectName)' != 'StorageTests'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LyricBridgeGuid" Value="$(LyricBridgeGuid)" />
    <AssemblyMetadata Include="LyricBridgeName" Value="$(LyricBridgeName)" />
  </ItemGroup>
</Project>
