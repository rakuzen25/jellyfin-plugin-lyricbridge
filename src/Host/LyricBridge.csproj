<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.LyricBridge</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.LyricBridge</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/LyricBridge.Core.csproj" />
    <ProjectReference Include="../Infrastructure/LyricBridge.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../vendor/Lyricify.Lyrics.Helper/Lyricify.Lyrics.Helper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(JellyfinReferenceDir)/MediaBrowser.*.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Api.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Data.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Database.Implementations.dll"
      Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Extensions.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Microsoft.Data.Sqlite.dll" Private="false" />
  </ItemGroup>
  <PropertyGroup>
    <PluginWebAssets Condition="'$(PluginWebAssets)' == ''">$(MSBuildThisFileDirectory)../../dist/web</PluginWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PluginWebAssets)/*"
      Exclude="$(PluginWebAssets)/demo.html;$(PluginWebAssets)/demo.wav"
      Link="Web/%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
