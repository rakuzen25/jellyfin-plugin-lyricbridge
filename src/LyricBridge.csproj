<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.LyricBridge</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.LyricBridge</AssemblyName>
    <Version>$(LyricBridgeVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs;Infrastructure/**/*.cs" />
    <ProjectReference Include="Core/LyricBridge.Core.csproj" />
    <ProjectReference Include="Infrastructure/LyricBridge.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Kawazu" Version="1.1.4" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../vendor/Lyricify.Lyrics.Helper/Lyricify.Lyrics.Helper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(JellyfinReferenceDir)/MediaBrowser.*.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Api.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Data.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Database.Implementations.dll"
      Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Jellyfin.Extensions.dll" Private="false" />
    <Reference Include="$(JellyfinReferenceDir)/Microsoft.Data.Sqlite.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../dist/web/*"
      Exclude="../dist/web/demo.html;../dist/web/demo.wav"
      Link="Web/%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(PkgKawazu)/content/*" CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest" Link="KawazuDictionary/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
