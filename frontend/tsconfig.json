{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "types": [],
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true
    },
    "include": ["**/*.ts"],
    "exclude": ["**/*.test.ts", "node_modules"]
}
