{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true
    },
    "include": ["bridge/**/*.ts", "renderer/**/*.ts", "admin/**/*.ts", "shared/**/*.ts", "*.ts"],
    "exclude": ["**/*.test.ts"]
}
