{
    "name": "lyricbridge-web",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "pnpm run check:boundaries && tsc --noEmit",
        "typecheck:legacy": "pnpm run check:boundaries && tsc6 --noEmit --stableTypeOrdering",
        "build": "pnpm run typecheck && node build.mjs",
        "test": "node --experimental-strip-types --test bridge/*.test.ts renderer/*.test.ts",
        "check:boundaries": "node check-boundaries.mjs"
    },
    "devDependencies": {
        "@typescript/native": "npm:typescript@7.0.2",
        "esbuild": "0.28.2",
        "typescript": "npm:@typescript/typescript6@6.0.2"
    },
    "dependencies": {
        "lucide": "1.56.0"
    }
}
