{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>rakuzen25/jellyfin-plugin-toolkit:tooling#v0.6.4", "github>rakuzen25/jellyfin-plugin-toolkit#v0.6.4"],
    "packageRules": [
        {
            "description": ["Pre-1.0 esbuild minor versions can break build behavior."],
            "matchPackageNames": ["esbuild"],
            "matchUpdateTypes": ["minor", "major"],
            "automerge": false,
            "groupName": null
        },
        {
            "description": ["Provider/converter behavior is only partly covered by mocked tests."],
            "matchPackageNames": ["Kawazu", "OpenccNetLib", "Lyricify.Lyrics.Helper"],
            "matchUpdateTypes": ["minor", "major"],
            "automerge": false,
            "groupName": null
        },
        {
            "matchPackageNames": ["xunit.v3", "xunit.analyzers"],
            "groupName": "Backend test infrastructure"
        },
        {
            "matchPackageNames": ["actions/upload-artifact", "actions/download-artifact"],
            "groupName": "GitHub artifact actions"
        },
        {
            "matchPackageNames": ["playwright", "mcr.microsoft.com/playwright"],
            "groupName": "Playwright package and image",
            "separateMajorMinor": true
        },
        {
            "matchPackageNames": ["playwright", "mcr.microsoft.com/playwright"],
            "matchUpdateTypes": ["minor", "major"],
            "automerge": false
        },
        {
            "description": ["Native compiler updates stay on stable TypeScript 7."],
            "matchPackageNames": ["typescript"],
            "allowedVersions": ">=7 <8"
        },
        {
            "description": ["Legacy compiler API updates stay on stable TypeScript 6."],
            "matchPackageNames": ["@typescript/typescript6"],
            "allowedVersions": ">=6 <7"
        },
        {
            "description": ["The compatibility wrapper's internal compiler stays on stable TypeScript 6."],
            "matchPackageNames": ["typescript"],
            "matchDepNames": ["@typescript/old"],
            "allowedVersions": ">=6 <7"
        }
    ],
    "gitIgnoredAuthors": ["342669125+finchaser-3-0[bot]@users.noreply.github.com"]
}
