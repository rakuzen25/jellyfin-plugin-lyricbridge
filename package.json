{
    "name": "lyricbridge",
    "private": true,
    "packageManager": "pnpm@12.11.2",
    "engines": {
        "node": "26.11.1",
        "pnpm": "12.11.2"
    },
    "scripts": {
        "build": "pnpm --dir frontend run build",
        "typecheck": "pnpm --dir frontend run typecheck",
        "test": "pnpm --dir frontend test",
        "test:browser": "sh scripts/test-browser.sh",
        "check:python": "sh scripts/check-python.sh",
        "format:python": "sh -c '\"${LYRICBRIDGE_PYTHON:-.venv/bin/python}\" -m ruff format scripts tests'",
        "check:dotnet": "bash scripts/format-dotnet.sh",
        "format:dotnet": "bash scripts/format-dotnet.sh --fix",
        "check": "pnpm lint && pnpm format:check && pnpm knip && pnpm typecheck && pnpm run check:python && pnpm run check:dotnet",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "pnpm lint --fix",
        "format": "prettier --write \"frontend/**/*.{ts,mjs,json,css,html}\" \"browser-tests/*.{cjs,mjs,json}\" \"scripts/**/*.mjs\" \"*.{json,mjs,yaml}\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"frontend/**/*.{ts,mjs,json,css,html}\" \"browser-tests/*.{cjs,mjs,json}\" \"scripts/**/*.mjs\" \"*.{json,mjs,yaml}\" \".github/**/*.yml\"",
        "knip": "knip",
        "test:tooling": "node --test scripts/*.test.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "knip": "6.41.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2"
    }
}
