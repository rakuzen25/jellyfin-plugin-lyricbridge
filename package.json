{
    "name": "lyricbridge",
    "private": true,
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": "26.12.0",
        "pnpm": "12.14.0"
    },
    "scripts": {
        "build": "pnpm --dir frontend run build",
        "typecheck": "pnpm --dir frontend run typecheck",
        "test": "pnpm --dir frontend test",
        "test:browser": "sh scripts/checks/test-browser.sh",
        "check:python": "sh scripts/checks/check-python.sh",
        "format:python": "sh -c '\"${LYRICBRIDGE_PYTHON:-.venv/bin/python}\" -m ruff format scripts tests'",
        "check:dotnet": "bash scripts/checks/format-dotnet.sh",
        "format:dotnet": "bash scripts/checks/format-dotnet.sh --fix",
        "check:docs": "python3 -m scripts.checks.docs",
        "check": "pnpm check:docs && pnpm lint && pnpm format:check && pnpm knip && pnpm typecheck && pnpm run check:python && pnpm run check:dotnet",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "pnpm lint --fix",
        "format": "prettier --write \"frontend/**/*.{ts,mjs,json,css,html}\" \"tests/browser/**/*.{cjs,mjs,json}\" \"tests/tooling/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,mjs,yaml}\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"frontend/**/*.{ts,mjs,json,css,html}\" \"tests/browser/**/*.{cjs,mjs,json}\" \"tests/tooling/**/*.mjs\" \"scripts/**/*.mjs\" \"*.{json,mjs,yaml}\" \".github/**/*.yml\"",
        "knip": "knip",
        "test:tooling": "node --test \"tests/tooling/**/*.test.mjs\""
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@typescript/native": "npm:typescript@7.0.2",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "knip": "6.41.0",
        "prettier": "3.9.10",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.71.2"
    }
}
